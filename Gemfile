# =====================================================================
# Gemfile は「このプロジェクトで使う gem（ライブラリ）」を書く場所です。
# ここに書いた gem は `bundle install` コマンドでまとめて入ります。
# =====================================================================

# gem をダウンロードしてくる場所（公式の配布サイト）です。
source "https://rubygems.org"

# このプロジェクトが対象とする Ruby のバージョンです。
# "~> 4.0" は「4.0 以上 4.1 未満」の意味で、4.0.6 や 4.0.7 などの
# パッチ違いをまとめて許可します。devcontainer 側の "ruby:4.0" と
# 足並みがそろい、パッチが上がっても bundle install が失敗しません。
ruby "~> 4.0"

# .env ファイルに書いた環境変数を読み込むための gem です。
# これのおかげで ENV["..."] で秘密の値を取り出せます。
# 【step1・step2 共通で使います】
gem "dotenv"

# --- ここから下は step2（送受信）でだけ使う gem です ---

# sinatra は「小さな Web サーバー」を簡単に作るための gem です。
# step2 では、LINE からの受信連絡(Webhook)を受け取るために使います。
gem "sinatra"

# puma は sinatra を実際に動かすためのサーバー本体です。
gem "puma"
