{
  // ===================================================================
  // GitHub Codespaces / VS Code Dev Container の設定ファイルです。
  // このファイルがあると、Codespaces を開いたときに
  // 自動で Ruby 4 の開発環境が用意されます。
  // ===================================================================

  // Codespaces の画面に表示される、この開発環境の名前です。
  "name": "LINE送信Bot (Ruby 4)",

  // 使う Docker イメージ（土台となる環境）です。
  // "ruby:4.0" は Ruby 4.0 系の「最新パッチ版」を指すタグです。
  // 例えば 4.0.6 や 4.0.7 が出ても、このタグ1つで自動的に
  // 最新の 4.0.x を使ってくれます（毎回書き換える必要がありません）。
  "image": "ruby:4.0",

  // コンテナが作られた「後」に自動で実行されるコマンドです。
  // ここで bundle install を実行し、Gemfile に書いた gem を入れます。
  "postCreateCommand": "bundle install",

  // VS Code（Codespaces のエディタ）に関する追加設定です。
  "customizations": {
    "vscode": {
      // 起動時に自動でインストールしてほしい拡張機能です。
      "extensions": [
        // Ruby のコード補完やエラー表示をしてくれる公式拡張です。
        "Shopify.ruby-lsp"
      ]
    }
  }
}
